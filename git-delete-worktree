#!/bin/bash

# Delete the git worktree you're currently inside.
#
# Usage: delete-worktree [--force]
#
# Refuses to run from the main working tree. Must be run from within a linked
# worktree. After removal, your shell will still be in the (now-gone) directory,
# so cd somewhere else afterward.

err_echo() {
  echo "$@" 1>&2;
}

absorb_eof() {
  local discarded
  read -r -t 2 -n 1 discarded 2>/dev/null
}

die() {
  absorb_eof
  exit 1
}

main(){
  local force worktree git_dir common_dir branch delete_flag

  force=""
  delete_flag="-D"
  if [ "$1" = "--force" ] || [ "$1" = "-f" ]; then
    force="--force"
  fi

  if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    err_echo "Not inside a git working tree."
    die
  fi

  git_dir="$(git rev-parse --git-dir)"
  common_dir="$(git rev-parse --git-common-dir)"
  git_dir="$(cd "$git_dir" && pwd)"
  common_dir="$(cd "$common_dir" && pwd)"

  if [ "$git_dir" = "$common_dir" ]; then
    err_echo "Refusing to delete: this is the main working tree, not a linked worktree."
    die
  fi

  worktree="$(git rev-parse --show-toplevel)"
  branch="$(git symbolic-ref --short -q HEAD)"

  echo "Removing worktree: $worktree"
  if ! git --git-dir="$common_dir" worktree remove $force "$worktree"; then
    die
  fi
  echo "Worktree removed. cd out of $worktree — it no longer exists."

  # cd into the main worktree so the remaining git commands have a valid working
  # directory (our original cwd was inside the now-removed worktree).
  cd "$(dirname "$common_dir")" || die

  if [ -z "$branch" ]; then
    err_echo "Worktree was detached; no branch to delete."
  else
    echo "Deleting branch: $branch"
    git --git-dir="$common_dir" branch $delete_flag "$branch"
  fi

  echo "Fetching remotes and pruning stale remote-tracking branches"
  git --git-dir="$common_dir" fetch --all --prune

  sync_default_branch "$common_dir"
}

# Fast-forward the local default branch (main/master/whatever origin says) to
# match the remote, without checking it out. Mirrors the pattern in
# ~/Projects/royvandewater/reel-in-the-fleet: ask origin for its default branch,
# then fetch straight into that local ref. The refspec fetch only fast-forwards,
# so it refuses (rather than clobbers) a divergent local branch.
sync_default_branch(){
  local common_dir="$1" default_branch

  if ! git --git-dir="$common_dir" remote get-url origin >/dev/null 2>&1; then
    err_echo "No origin remote; skipping default branch sync."
    return
  fi

  # Ask the remote what its default branch actually is, rather than assuming
  # "main" — some repos use master or something else entirely.
  default_branch="$(git --git-dir="$common_dir" ls-remote --symref origin HEAD 2>/dev/null \
    | awk '/^ref:/ { sub("refs/heads/", "", $2); print $2; exit }')"
  if [ -z "$default_branch" ]; then
    err_echo "Could not determine remote default branch; skipping default branch sync."
    return
  fi

  # If the default branch is checked out in a worktree, git won't let us update
  # its ref out from under it. Leave it for the user to fast-forward themselves.
  if git --git-dir="$common_dir" worktree list --porcelain \
    | grep -q "^branch refs/heads/$default_branch\$"; then
    err_echo "Default branch '$default_branch' is checked out in a worktree; leaving it alone."
    return
  fi

  echo "Fast-forwarding local $default_branch to origin/$default_branch"
  git --git-dir="$common_dir" fetch origin "refs/heads/$default_branch:refs/heads/$default_branch"
}
main "$@"
